---
import { highlightCode } from '../lib/shiki-highlighter';
import CopyButton from './CopyButton.astro';

interface CodeBlock {
  label: string;
  value: string;
  lang?: string;
  icon?: string;
}

interface Props {
  blocks: CodeBlock[];
  defaultValue?: string;
  class?: string;
}

const { blocks, defaultValue, class: className = '' } = Astro.props;
const activeTab = defaultValue || blocks[0]?.value || '';

const highlighted = await Promise.all(
  blocks.map((block) => highlightCode(block.value, block.lang || 'bash'))
);
---

<div class:list={['code-tabs rounded-xl border border-[#27272a] overflow-hidden bg-[#09090b] shadow-2xl my-4', className]}>
  <div class="code-tabs-list flex items-center border-b border-[#27272a] bg-[#121215] px-3 py-1">
    <div class="flex items-center gap-1.5 mr-3 px-1">
      <div class="w-2.5 h-2.5 rounded-full bg-[#3f3f46]"></div>
      <div class="w-2.5 h-2.5 rounded-full bg-[#3f3f46]"></div>
      <div class="w-2.5 h-2.5 rounded-full bg-[#3f3f46]"></div>
    </div>
    <div class="flex items-center gap-1 overflow-x-auto py-1">
      {blocks.map((block) => (
        <button
          class:list={[
            'code-tab-trigger flex items-center gap-1.5 px-3 py-1.5 text-[12px] font-mono transition-all duration-150 rounded-md shrink-0',
            block.value === activeTab
              ? 'text-white bg-[#1c1c21] font-semibold border border-[#3f3f46]'
              : 'text-zinc-400 hover:text-white hover:bg-[#18181b]',
          ]}
          data-tab={block.value}
        >
          {block.icon && <span class="text-[11px] text-dracula-cyan font-bold">{block.icon}</span>}
          <span>{block.label}</span>
        </button>
      ))}
    </div>
    <div class="ml-auto pl-2">
      <CopyButton code={blocks.find(b => b.value === activeTab)?.value || ''} class="code-copy-btn text-zinc-300 hover:text-white" />
    </div>
  </div>

  <div class="code-tabs-panels bg-[#09090b]">
    {blocks.map((block, i) => (
      <div
        class:list={['code-tab-panel p-4 sm:p-5 overflow-x-auto font-mono text-[13.5px] leading-relaxed text-white', block.value === activeTab ? '' : 'hidden']}
        data-panel={block.value}
      >
        <div class="code-block text-white" set:html={highlighted[i]} />
      </div>
    ))}
  </div>
</div>

<script>
  document.querySelectorAll('.code-tabs').forEach((container) => {
    const triggers = container.querySelectorAll('.code-tab-trigger');
    const panels = container.querySelectorAll('.code-tab-panel');

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const targetValue = trigger.getAttribute('data-tab');

        triggers.forEach((t) => {
          if (t.getAttribute('data-tab') === targetValue) {
            t.classList.add('text-white', 'bg-[#1c1c21]', 'font-semibold', 'border', 'border-[#3f3f46]');
            t.classList.remove('text-zinc-400', 'hover:bg-[#18181b]');
          } else {
            t.classList.remove('text-white', 'bg-[#1c1c21]', 'font-semibold', 'border', 'border-[#3f3f46]');
            t.classList.add('text-zinc-400', 'hover:bg-[#18181b]');
          }
        });

        panels.forEach((p) => {
          if (p.getAttribute('data-panel') === targetValue) {
            p.classList.remove('hidden');
          } else {
            p.classList.add('hidden');
          }
        });
      });
    });
  });
</script>
