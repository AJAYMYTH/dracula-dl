---
import Base from '../layouts/Base.astro';
import SpotlightCard from '../components/SpotlightCard.astro';
import { Terminal, Sliders, Palette, ListOrdered, Settings, Info, History, Package, Video, Music } from 'lucide-astro';
---

<Base title="TUI Guide" description="Interactive terminal user interface guide for The Dracula YouTube downloader.">
  <div class="max-w-[800px] mx-auto px-4 sm:px-6 py-12 sm:py-20">
    <div class="mb-10 sm:mb-14" data-animate>
      <p class="font-mono text-[11px] sm:text-[12px] text-dracula-red uppercase tracking-wider mb-2 sm:mb-3 flex items-center gap-1.5">
        <Terminal class="w-3.5 h-3.5" />
        <span>Interactive Interface</span>
      </p>
      <h1 class="text-[30px] sm:text-[42px] md:text-[52px] font-semibold tracking-display-lg text-ink mb-3 sm:mb-4">Interactive TUI.</h1>
      <p class="text-[15px] sm:text-[17px] text-body leading-[1.65]">A menu-driven Rich terminal application featuring live progress bars, format tables, and system diagnostics.</p>
    </div>

    <!-- TUI Preview Mockup -->
    <section class="mb-12 sm:mb-16" data-animate>
      <div class="rounded-xl border border-hairline/80 bg-[#09090b] overflow-hidden shadow-elevated w-full">
        <div class="flex items-center justify-between px-3.5 sm:px-4 py-2.5 sm:py-3 border-b border-hairline/60 bg-[#121215]">
          <div class="flex items-center gap-2 min-w-0">
            <div class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-hairline-strong/40 shrink-0"></div>
            <div class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-hairline-strong/40 shrink-0"></div>
            <div class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-hairline-strong/40 shrink-0"></div>
            <span class="ml-1.5 sm:ml-2 text-[11px] sm:text-[12px] font-mono text-muted flex items-center gap-1.5 truncate">
              <Terminal class="w-3.5 h-3.5 text-dracula-red shrink-0" />
              <span class="truncate">The Dracula Interactive Shell</span>
            </span>
          </div>
          <span class="text-[10px] sm:text-[11px] font-mono text-dracula-red bg-dracula-red-soft px-2 py-0.5 rounded-full border border-dracula-red/30 shrink-0">Rich TUI</span>
        </div>
        <div class="p-4 sm:p-6 overflow-x-auto">
          <pre class="text-[9.5px] xs:text-[11px] md:text-[12px] font-mono text-dracula-red leading-tight"><code>  ██████╗ ██████╗  █████╗  ██████╗██╗   ██╗██╗      █████╗ 
  ██╔══██╗██╔══██╗██╔══██╗██╔════╝██║   ██║██║     ██╔══██╗
  ██║  ██║██████╔╝███████║██║     ██║   ██║██║     ███████║
  ██║  ██║██╔══██╗██╔══██║██║     ██║   ██║██║     ██╔══██║
  ██████╔╝██║  ██║██║  ██║╚██████╗╚██████╔╝███████╗██║  ██║
  ╚═════╝ ╚═╝  ╚═╝╚═╝  ╚═╝ ╚═════╝ ╚═════╝ ╚══════╝╚═╝  ╚═╝</code></pre>
          <pre class="text-[12px] sm:text-[13px] font-mono text-zinc-300 mt-3 leading-[1.6]"><code>  <span class="text-ink font-semibold">The Dracula</span>  ·  YouTube Downloader CLI  <span class="text-dracula-red font-semibold">v1.1.2</span>
  Powered by yt-dlp  ·  Rising from the dark...</code></pre>
        </div>
      </div>
    </section>

    <!-- Interactive Menu Section -->
    <section class="mb-12 sm:mb-16" data-animate>
      <h2 class="text-[20px] sm:text-[24px] font-semibold tracking-tight text-ink mb-3 sm:mb-4 flex items-center gap-2">
        <Sliders class="w-4 h-4 sm:w-5 sm:h-5 text-dracula-cyan shrink-0" />
        <span>Interactive Menu Options</span>
      </h2>
      <p class="text-[13.5px] sm:text-[14px] text-body leading-[1.65] mb-5 sm:mb-6">Launch <code class="font-mono text-[12px] sm:text-[13px] text-ink bg-[#18181b] px-2 py-0.5 rounded border border-[#27272a]">dracula</code> to navigate the step-by-step interactive workflow:</p>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 sm:gap-4">
        {[
          { num: '01', icon: Video, title: 'Download Video', desc: 'Paste URL, select quality, subtitles, and embedded thumbnails.' },
          { num: '02', icon: Music, title: 'Download Audio', desc: 'Extract audio as MP3, M4A, FLAC, WAV, OPUS with custom bitrates.' },
          { num: '03', icon: ListOrdered, title: 'Download Playlist', desc: 'Download playlists with index filtering and retry-failed support.' },
          { num: '04', icon: Package, title: 'Batch Download', desc: 'Process multiple URLs from files (urls.txt) or direct lists.' },
          { num: '05', icon: History, title: 'Download History', desc: 'Browse past download records and logs in a Rich table view.' },
          { num: '06', icon: Terminal, title: 'List Formats', desc: 'View raw video & audio streams, resolutions, codecs, and sizes.' },
          { num: '07', icon: Settings, title: 'Config / Settings', desc: 'View and update persistent defaults in ~/.config/dracula/config.toml.' },
          { num: '08', icon: Info, title: 'About / System Info', desc: 'View package versions, FFmpeg status, and system platform info.' },
        ].map((item) => (
          <SpotlightCard class="p-4 sm:p-5">
            <div class="flex items-start gap-3.5 sm:gap-4">
              <span class="bg-canvas-soft-2 border border-hairline/80 text-dracula-red text-[11px] font-mono font-semibold px-2 sm:px-2.5 py-1 rounded-md shrink-0">{item.num}</span>
              <div>
                <p class="text-[14px] sm:text-[15px] font-semibold text-ink mb-1 flex items-center gap-1.5">
                  <item.icon class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-dracula-red shrink-0" />
                  <span>{item.title}</span>
                </p>
                <p class="text-[12.5px] sm:text-[13px] text-body leading-[1.5]">{item.desc}</p>
              </div>
            </div>
          </SpotlightCard>
        ))}
      </div>
    </section>

    <!-- Color Palette Section -->
    <section data-animate>
      <h2 class="text-[20px] sm:text-[24px] font-semibold tracking-tight text-ink mb-3 sm:mb-4 flex items-center gap-2">
        <Palette class="w-4 h-4 sm:w-5 sm:h-5 text-dracula-purple shrink-0" />
        <span>Color Palette Reference</span>
      </h2>
      <p class="text-[13.5px] sm:text-[14px] text-body leading-[1.65] mb-5 sm:mb-6">The TUI features Dracula-inspired high contrast color tokens:</p>

      <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 sm:gap-3">
        {[
          { name: 'Dracula Red', hex: '#ff2d55', bg: 'bg-dracula-red' },
          { name: 'Dracula Purple', hex: '#bd93f9', bg: 'bg-dracula-purple' },
          { name: 'Dracula Green', hex: '#50fa7b', bg: 'bg-dracula-green' },
          { name: 'Dracula Orange', hex: '#ffb86c', bg: 'bg-dracula-orange' },
          { name: 'Dracula Pink', hex: '#ff79c6', bg: 'bg-dracula-pink' },
          { name: 'Dracula Cyan', hex: '#8be9fd', bg: 'bg-dracula-cyan' },
        ].map((c) => (
          <div class="bg-canvas-soft-2 border border-hairline/60 rounded-xl p-3.5 sm:p-4 flex items-center gap-2.5 sm:gap-3">
            <div class={`w-3.5 h-3.5 sm:w-4 sm:h-4 rounded-full ${c.bg} shrink-0 shadow-sm`}></div>
            <div>
              <p class="text-[12px] sm:text-[13px] font-medium text-ink">{c.name}</p>
              <p class="text-[10px] sm:text-[11px] font-mono text-muted">{c.hex}</p>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</Base>
