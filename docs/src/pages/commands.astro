---
import Base from '../layouts/Base.astro';
import { Terminal, Command, ListFilter } from 'lucide-astro';

const commands = [
  {
    name: 'video',
    description: 'Download a YouTube video with quality, subtitle, and thumbnail controls.',
    usage: 'dracula video -u URL [options]',
    flags: [
      { flag: '--url', short: '-u', default: 'required*', description: 'YouTube video URL' },
      { flag: '--quality', short: '-q', default: '720p', description: 'Quality: best/4k/1440p/1080p/720p/480p/360p/worst' },
      { flag: '--format-id', short: '-f', default: '—', description: 'Specific yt-dlp format ID' },
      { flag: '--subs', short: '—', default: '—', description: 'Comma-separated subtitle language codes (e.g. en,es)' },
      { flag: '--auto-subs', short: '—', default: 'off', description: 'Download auto-generated subtitles' },
      { flag: '--embed-subs', short: '—', default: 'off', description: 'Embed subtitles into video container' },
      { flag: '--embed-thumbnail', short: '—', default: 'off', description: 'Embed thumbnail image into video file' },
      { flag: '--output', short: '-o', default: '~/Downloads/Dracula', description: 'Output directory' },
      { flag: '--limit-rate', short: '—', default: '—', description: 'Maximum download speed limit (e.g. 500k, 2m)' },
      { flag: '--dry-run', short: '—', default: 'off', description: 'Simulate download without saving files' },
    ],
  },
  {
    name: 'audio',
    description: 'Extract audio tracks in MP3, M4A, FLAC, WAV, OPUS, or AAC formats.',
    usage: 'dracula audio -u URL [options]',
    flags: [
      { flag: '--url', short: '-u', default: 'required*', description: 'YouTube video URL' },
      { flag: '--format', short: '-f', default: 'mp3', description: 'Audio format: mp3/m4a/wav/flac/opus/aac' },
      { flag: '--bitrate', short: '-b', default: '192', description: 'Bitrate in kbps: 128/192/256/320' },
      { flag: '--embed-thumbnail', short: '—', default: 'off', description: 'Embed cover art into audio metadata' },
      { flag: '--output', short: '-o', default: '~/Downloads/Dracula', description: 'Output directory' },
      { flag: '--limit-rate', short: '—', default: '—', description: 'Maximum download speed limit (e.g. 500k, 2m)' },
      { flag: '--dry-run', short: '—', default: 'off', description: 'Simulate download without saving files' },
    ],
  },
  {
    name: 'playlist',
    description: 'Download full YouTube playlists with item range filtering and failed item retries.',
    usage: 'dracula playlist -u URL [options]',
    flags: [
      { flag: '--url', short: '-u', default: 'required*', description: 'Playlist URL' },
      { flag: '--quality', short: '-q', default: '720p', description: 'Video quality' },
      { flag: '--audio-only', short: '—', default: 'off', description: 'Download audio only' },
      { flag: '--format', short: '-f', default: 'mp3', description: 'Audio format (with --audio-only)' },
      { flag: '--bitrate', short: '-b', default: '192', description: 'Audio bitrate kbps (with --audio-only)' },
      { flag: '--start', short: '—', default: '—', description: 'Start at playlist item index number' },
      { flag: '--end', short: '—', default: '—', description: 'End at playlist item index number' },
      { flag: '--subs', short: '—', default: '—', description: 'Comma-separated subtitle language codes' },
      { flag: '--auto-subs', short: '—', default: 'off', description: 'Download auto-generated subtitles' },
      { flag: '--embed-subs', short: '—', default: 'off', description: 'Embed subtitles into output' },
      { flag: '--embed-thumbnail', short: '—', default: 'off', description: 'Embed thumbnail into output files' },
      { flag: '--retry-failed', short: '—', default: 'off', description: 'Re-attempt only items that failed previously' },
      { flag: '--output', short: '-o', default: '~/Downloads/Dracula', description: 'Output directory' },
    ],
  },
  {
    name: 'batch',
    description: 'Download multiple URLs sequentially from a text file or command line arguments.',
    usage: 'dracula batch -i urls.txt [options] OR dracula batch -u URL1 -u URL2',
    flags: [
      { flag: '--input-file', short: '-i', default: '—', description: 'Path to text file containing URLs' },
      { flag: '--url', short: '-u', default: '—', description: 'Target URL (repeat flag for multiple URLs)' },
      { flag: '--quality', short: '-q', default: '720p', description: 'Video quality' },
      { flag: '--audio-only', short: '—', default: 'off', description: 'Download audio only' },
      { flag: '--format', short: '-f', default: 'mp3', description: 'Audio format' },
      { flag: '--bitrate', short: '-b', default: '192', description: 'Audio bitrate kbps' },
      { flag: '--subs', short: '—', default: '—', description: 'Subtitle language codes' },
      { flag: '--auto-subs', short: '—', default: 'off', description: 'Download auto-generated subtitles' },
      { flag: '--embed-subs', short: '—', default: 'off', description: 'Embed subtitles' },
      { flag: '--embed-thumbnail', short: '—', default: 'off', description: 'Embed thumbnail' },
      { flag: '--output', short: '-o', default: '~/Downloads/Dracula', description: 'Output directory' },
    ],
  },
  {
    name: 'formats',
    description: 'List all raw video and audio format streams available for a URL.',
    usage: 'dracula formats -u URL',
    flags: [
      { flag: '--url', short: '-u', default: 'required*', description: 'YouTube video URL' },
    ],
  },
  {
    name: 'history',
    description: 'Display recent download history records logged in ~/.config/dracula/history.jsonl.',
    usage: 'dracula history [-n LIMIT]',
    flags: [
      { flag: '--limit', short: '-n', default: '50', description: 'Number of recent history records to display' },
    ],
  },
  {
    name: 'completion',
    description: 'Output setup instructions for bash/zsh shell auto-completion.',
    usage: 'dracula completion',
    flags: [],
  },
];
---

<Base title="Commands Reference" description="Complete command-line interface reference for The Dracula downloader.">
  <div class="max-w-[800px] mx-auto px-4 sm:px-6 py-12 sm:py-20">
    <div class="mb-10 sm:mb-14" data-animate>
      <p class="font-mono text-[11px] sm:text-[12px] text-dracula-red uppercase tracking-wider mb-2 sm:mb-3 flex items-center gap-1.5">
        <Command class="w-3.5 h-3.5" />
        <span>API & CLI Reference</span>
      </p>
      <h1 class="text-[30px] sm:text-[42px] md:text-[52px] font-semibold tracking-display-lg text-ink mb-3 sm:mb-4">Commands.</h1>
      <p class="text-[15px] sm:text-[17px] text-body leading-[1.65]">Complete specifications for all subcommands, options, and flags in Dracula CLI v1.1.2.</p>
    </div>

    <!-- Quick Reference Card -->
    <section class="mb-12 sm:mb-16" data-animate>
      <div class="bg-[#09090b] border border-hairline/80 rounded-xl p-4 sm:p-6 shadow-sm">
        <div class="flex items-center justify-between mb-3 sm:mb-4 pb-3 border-b border-hairline/60">
          <span class="font-mono text-[11px] text-muted uppercase tracking-wider flex items-center gap-1.5">
            <ListFilter class="w-3.5 h-3.5 text-dracula-red shrink-0" />
            <span>Quick Reference</span>
          </span>
          <span class="font-mono text-[10px] sm:text-[11px] text-dracula-red bg-dracula-red-soft px-2 py-0.5 rounded-full border border-dracula-red/30 shrink-0">v1.1.2</span>
        </div>
        <pre class="text-[12px] sm:text-[13.5px] font-mono leading-[2] text-zinc-100 overflow-x-auto"><code><span class="text-dracula-cyan">dracula</span>                                 <span class="text-muted"># Launch interactive TUI</span>
<span class="text-dracula-cyan">dracula video</span>    -u URL                 <span class="text-muted"># Download single video</span>
<span class="text-dracula-cyan">dracula audio</span>    -u URL                 <span class="text-muted"># Extract audio track</span>
<span class="text-dracula-cyan">dracula playlist</span> -u URL                 <span class="text-muted"># Download playlist</span>
<span class="text-dracula-cyan">dracula batch</span>    -i urls.txt            <span class="text-muted"># Batch download URLs</span>
<span class="text-dracula-cyan">dracula formats</span>  -u URL                 <span class="text-muted"># List available formats</span>
<span class="text-dracula-cyan">dracula history</span>  -n 50                  <span class="text-muted"># View download history</span>
<span class="text-dracula-cyan">dracula completion</span>                      <span class="text-muted"># Shell completion setup</span></code></pre>
      </div>
    </section>

    <!-- Subcommand Sections -->
    {commands.map((cmd, i) => (
      <section class="mb-12 sm:mb-16 border-b border-hairline/60 pb-10 sm:pb-12" data-animate>
        <div class="flex items-center gap-3 mb-2 sm:mb-3">
          <span class="font-mono text-[12px] text-muted">0{i + 1}</span>
          <h2 class="text-[22px] sm:text-[26px] font-semibold tracking-tight text-ink flex items-center gap-2">
            <Terminal class="w-4 h-4 sm:w-5 sm:h-5 text-dracula-red shrink-0" />
            <span>{cmd.name}</span>
          </h2>
        </div>
        <p class="text-[13.5px] sm:text-[14px] text-body leading-[1.6] mb-4">{cmd.description}</p>
        
        <div class="bg-[#09090b] border border-hairline/80 rounded-lg p-3.5 sm:p-4 mb-5 overflow-x-auto">
          <pre class="text-[12px] sm:text-[13.5px] font-mono text-zinc-100 whitespace-nowrap"><code><span class="text-dracula-green font-bold">$</span> {cmd.usage}</code></pre>
        </div>

        {cmd.flags.length > 0 ? (
          <div class="border border-hairline/70 rounded-xl overflow-hidden bg-[#09090b]">
            <div class="overflow-x-auto">
              <table class="w-full text-left border-collapse min-w-[540px]">
                <thead>
                  <tr class="bg-[#121215] border-b border-hairline/70">
                    <th class="px-3.5 sm:px-4 py-2.5 sm:py-3 font-mono text-[10px] sm:text-[11px] text-muted uppercase tracking-wider">Flag</th>
                    <th class="px-3.5 sm:px-4 py-2.5 sm:py-3 font-mono text-[10px] sm:text-[11px] text-muted uppercase tracking-wider">Short</th>
                    <th class="px-3.5 sm:px-4 py-2.5 sm:py-3 font-mono text-[10px] sm:text-[11px] text-muted uppercase tracking-wider">Default</th>
                    <th class="px-3.5 sm:px-4 py-2.5 sm:py-3 font-mono text-[10px] sm:text-[11px] text-muted uppercase tracking-wider">Description</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-hairline/50">
                  {cmd.flags.map((flag) => (
                    <tr class="hover:bg-canvas-soft-2/50 transition-colors">
                      <td class="px-3.5 sm:px-4 py-2.5 sm:py-3 text-[12px] sm:text-[13px] font-mono text-dracula-cyan font-semibold whitespace-nowrap">{flag.flag}</td>
                      <td class="px-3.5 sm:px-4 py-2.5 sm:py-3 text-[12px] sm:text-[13px] font-mono text-zinc-200 whitespace-nowrap">{flag.short}</td>
                      <td class="px-3.5 sm:px-4 py-2.5 sm:py-3 text-[12px] sm:text-[13px] font-mono text-muted whitespace-nowrap">{flag.default}</td>
                      <td class="px-3.5 sm:px-4 py-2.5 sm:py-3 text-[12.5px] sm:text-[13px] text-zinc-300">{flag.description}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        ) : (
          <p class="text-[13px] text-muted font-mono italic">No additional options required for this subcommand.</p>
        )}
      </section>
    ))}
  </div>
</Base>
