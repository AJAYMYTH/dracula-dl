---
import Base from '../layouts/Base.astro';
import CodeTabs from '../components/CodeTabs.astro';
import { Terminal, Video, Music, Package, History } from 'lucide-astro';
---

<Base title="CLI Guide" description="Complete command-line interface guide for The Dracula YouTube Downloader.">
  <div class="max-w-[800px] mx-auto px-4 sm:px-6 py-12 sm:py-20">
    <div class="mb-10 sm:mb-14" data-animate>
      <p class="font-mono text-[11px] sm:text-[12px] text-dracula-red uppercase tracking-wider mb-2 sm:mb-3 flex items-center gap-1.5">
        <Terminal class="w-3.5 h-3.5" />
        <span>CLI Documentation</span>
      </p>
      <h1 class="text-[30px] sm:text-[42px] md:text-[52px] font-semibold tracking-display-lg text-ink mb-3 sm:mb-4">CLI Usage.</h1>
      <p class="text-[15px] sm:text-[17px] text-body leading-[1.65]">The Dracula CLI provides direct commands for automated scripts and terminal power-users.</p>
    </div>

    <!-- Section 1: Interactive Mode -->
    <section class="mb-12 sm:mb-16 border-b border-hairline/60 pb-10 sm:pb-12" data-animate>
      <div class="flex items-center gap-3 mb-3 sm:mb-4">
        <div class="w-7 h-7 rounded-full bg-canvas-soft-2 border border-hairline/80 flex items-center justify-center text-ink text-[12px] font-mono font-semibold shrink-0">01</div>
        <h2 class="text-[20px] sm:text-[24px] font-semibold tracking-tight text-ink flex items-center gap-2">
          <Terminal class="w-4 h-4 sm:w-5 sm:h-5 text-dracula-red shrink-0" />
          <span>Interactive Mode</span>
        </h2>
      </div>
      <p class="text-[13.5px] sm:text-[14px] text-body leading-[1.65] mb-4 sm:mb-5">Launch without arguments to enter the menu-driven prompt interface:</p>

      <CodeTabs
        blocks={[
          { label: 'Installed Package', value: 'dracula', lang: 'bash', icon: '$' },
          { label: 'From Source', value: 'python dracula.py', lang: 'bash', icon: '$' },
        ]}
      />
    </section>

    <!-- Section 2: Video Downloads -->
    <section class="mb-12 sm:mb-16 border-b border-hairline/60 pb-10 sm:pb-12" data-animate>
      <div class="flex items-center gap-3 mb-3 sm:mb-4">
        <div class="w-7 h-7 rounded-full bg-canvas-soft-2 border border-hairline/80 flex items-center justify-center text-ink text-[12px] font-mono font-semibold shrink-0">02</div>
        <h2 class="text-[20px] sm:text-[24px] font-semibold tracking-tight text-ink flex items-center gap-2">
          <Video class="w-4 h-4 sm:w-5 sm:h-5 text-dracula-cyan shrink-0" />
          <span>Download Videos</span>
        </h2>
      </div>
      <p class="text-[13.5px] sm:text-[14px] text-body leading-[1.65] mb-4 sm:mb-5">Download single videos with resolution, subtitle, thumbnail, and speed limit controls:</p>

      <CodeTabs
        blocks={[
          {
            label: 'Examples',
            value: `# Default 720p download
dracula video -u "https://youtube.com/watch?v=..."

# Specific quality with subtitle embedding & cover art
dracula video -u "URL" -q 1080p --subs en --embed-subs --embed-thumbnail

# 4K download with speed limit & dry-run simulation
dracula video -u "URL" -q 4k --limit-rate 2M --dry-run`,
            lang: 'bash',
            icon: '$',
          },
        ]}
        class="mb-6"
      />

      <p class="text-[12px] sm:text-[13px] font-mono text-muted uppercase tracking-wider mb-3">Available Video Qualities</p>
      <div class="flex flex-wrap gap-1.5 sm:gap-2">
        {['best', '4k', '1440p', '1080p', '720p', '480p', '360p', 'worst'].map((q) => (
          <span class="bg-canvas-soft-2 border border-hairline/80 rounded-md px-2.5 sm:px-3 py-1 text-[11px] sm:text-[12px] font-mono text-ink">{q}</span>
        ))}
      </div>
    </section>

    <!-- Section 3: Audio Extraction -->
    <section class="mb-12 sm:mb-16 border-b border-hairline/60 pb-10 sm:pb-12" data-animate>
      <div class="flex items-center gap-3 mb-3 sm:mb-4">
        <div class="w-7 h-7 rounded-full bg-canvas-soft-2 border border-hairline/80 flex items-center justify-center text-ink text-[12px] font-mono font-semibold shrink-0">03</div>
        <h2 class="text-[20px] sm:text-[24px] font-semibold tracking-tight text-ink flex items-center gap-2">
          <Music class="w-4 h-4 sm:w-5 sm:h-5 text-dracula-purple shrink-0" />
          <span>Download Audio Only</span>
        </h2>
      </div>
      <p class="text-[13.5px] sm:text-[14px] text-body leading-[1.65] mb-4 sm:mb-5">Extract audio tracks in high quality formats with embedded cover art:</p>

      <CodeTabs
        blocks={[
          {
            label: 'Examples',
            value: `# Default MP3 at 192kbps
dracula audio -u "URL"

# High quality 320kbps MP3 with album art
dracula audio -u "URL" -f mp3 -b 320 --embed-thumbnail

# Lossless FLAC extraction
dracula audio -u "URL" -f flac`,
            lang: 'bash',
            icon: '$',
          },
        ]}
      />
    </section>

    <!-- Section 4: Batch Downloads -->
    <section class="mb-12 sm:mb-16 border-b border-hairline/60 pb-10 sm:pb-12" data-animate>
      <div class="flex items-center gap-3 mb-3 sm:mb-4">
        <div class="w-7 h-7 rounded-full bg-canvas-soft-2 border border-hairline/80 flex items-center justify-center text-ink text-[12px] font-mono font-semibold shrink-0">04</div>
        <h2 class="text-[20px] sm:text-[24px] font-semibold tracking-tight text-ink flex items-center gap-2">
          <Package class="w-4 h-4 sm:w-5 sm:h-5 text-dracula-orange shrink-0" />
          <span>Batch Download URLs</span>
        </h2>
      </div>
      <p class="text-[13.5px] sm:text-[14px] text-body leading-[1.65] mb-4 sm:mb-5">Process dozens of URLs sequentially from text files or multiple URL flags:</p>

      <CodeTabs
        blocks={[
          {
            label: 'Batch Examples',
            value: `# Batch video download from text file (urls.txt)
dracula batch -i urls.txt -q 1080p

# Batch download multiple URLs directly via flags
dracula batch -u "https://..." -u "https://..." -q 720p

# Batch audio extraction from file
dracula batch -i urls.txt --audio-only -f mp3 -b 320`,
            lang: 'bash',
            icon: '$',
          },
        ]}
      />
    </section>

    <!-- Section 5: History & Completion -->
    <section data-animate>
      <div class="flex items-center gap-3 mb-3 sm:mb-4">
        <div class="w-7 h-7 rounded-full bg-canvas-soft-2 border border-hairline/80 flex items-center justify-center text-ink text-[12px] font-mono font-semibold shrink-0">05</div>
        <h2 class="text-[20px] sm:text-[24px] font-semibold tracking-tight text-ink flex items-center gap-2">
          <History class="w-4 h-4 sm:w-5 sm:h-5 text-dracula-green shrink-0" />
          <span>History & Shell Completion</span>
        </h2>
      </div>
      <p class="text-[13.5px] sm:text-[14px] text-body leading-[1.65] mb-4 sm:mb-5">Access download history logs and configure shell auto-completion:</p>

      <CodeTabs
        blocks={[
          {
            label: 'Commands',
            value: `# Show 50 recent download records
dracula history -n 50

# Display shell auto-completion setup guide
dracula completion

# Re-attempt failed items from previous playlist run
dracula playlist -u "URL" --retry-failed`,
            lang: 'bash',
            icon: '$',
          },
        ]}
      />
    </section>
  </div>
</Base>
