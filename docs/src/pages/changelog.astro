---
import Base from '../layouts/Base.astro';
import CodeTabs from '../components/CodeTabs.astro';
import { Rocket, Zap, Bug, Clock } from 'lucide-astro';
---

<Base title="Changelog" description="Release history and version updates for The Dracula YouTube Downloader.">
  <div class="max-w-[800px] mx-auto px-6 py-20">
    <div class="mb-14" data-animate>
      <p class="font-mono text-[12px] text-dracula-red uppercase tracking-wider mb-3 flex items-center gap-1.5">
        <Clock class="w-3.5 h-3.5" />
        <span>Releases & Timeline</span>
      </p>
      <h1 class="text-[40px] md:text-[52px] font-semibold tracking-display-lg text-ink mb-4">Changelog.</h1>
      <p class="text-[17px] text-body leading-[1.65]">All notable updates, feature additions, and bug fixes for <code class="bg-canvas-soft-2 px-2 py-0.5 rounded text-ink font-mono text-[14px]">dracula-dl</code>.</p>
    </div>

    <!-- Release 1.1.2 -->
    <div class="border border-hairline/80 bg-canvas-soft-2/80 rounded-2xl p-8 mb-12 shadow-elevated" data-animate>
      <div class="flex flex-wrap items-center justify-between gap-4 mb-6 border-b border-hairline/60 pb-5">
        <div class="flex items-center gap-3">
          <span class="text-[22px] font-semibold tracking-tight text-ink">v1.1.2</span>
          <span class="bg-dracula-red-soft border border-dracula-red/30 text-dracula-red font-mono text-[11px] font-semibold px-3 py-0.5 rounded-full">Latest Release</span>
        </div>
        <span class="font-mono text-[12px] text-muted">July 28, 2026</span>
      </div>

      <div class="space-y-8">
        <div>
          <h3 class="flex items-center gap-2 text-[16px] font-semibold text-ink mb-4">
            <Rocket class="w-4 h-4 text-dracula-red" />
            <span>Major Enhancements in v1.1.2</span>
          </h3>
          <ul class="space-y-3.5 text-[14px] text-body leading-[1.65]">
            <li class="pl-4 border-l-2 border-dracula-red/50">
              <strong class="text-ink">Fixed Playlist Audio Bitrate Encoding</strong> — Resolved an issue where audio-only playlist downloads ignored custom bitrate flags and hardcoded 192kbps.
            </li>
            <li class="pl-4 border-l-2 border-dracula-red/50">
              <strong class="text-ink">Unified Package Architecture</strong> — Root launcher scripts (<code class="bg-[#18181b] text-white px-1.5 py-0.5 rounded font-mono text-[12px]">dracula.py</code>, <code class="bg-[#18181b] text-white px-1.5 py-0.5 rounded font-mono text-[12px]">tui.py</code>, <code class="bg-[#18181b] text-white px-1.5 py-0.5 rounded font-mono text-[12px]">setup_check.py</code>) are now thin wrappers importing from <code class="bg-[#18181b] text-dracula-cyan px-1.5 py-0.5 rounded font-mono text-[12px]">dracula_dl</code> to guarantee 100% code parity.
            </li>
            <li class="pl-4 border-l-2 border-dracula-red/50">
              <strong class="text-ink">Dedicated Batch Mode & Subcommands</strong> — Added <code class="bg-[#18181b] text-white px-1.5 py-0.5 rounded font-mono text-[12px]">dracula batch -i urls.txt</code>, <code class="bg-[#18181b] text-white px-1.5 py-0.5 rounded font-mono text-[12px]">dracula history -n 50</code>, and <code class="bg-[#18181b] text-white px-1.5 py-0.5 rounded font-mono text-[12px]">dracula completion</code> subcommands.
            </li>
            <li class="pl-4 border-l-2 border-dracula-red/50">
              <strong class="text-ink">Subtitles & Thumbnail Embedding Flags</strong> — Introduced <code class="bg-[#18181b] text-white px-1.5 py-0.5 rounded font-mono text-[12px]">--subs</code>, <code class="bg-[#18181b] text-white px-1.5 py-0.5 rounded font-mono text-[12px]">--auto-subs</code>, <code class="bg-[#18181b] text-white px-1.5 py-0.5 rounded font-mono text-[12px]">--embed-subs</code>, and <code class="bg-[#18181b] text-white px-1.5 py-0.5 rounded font-mono text-[12px]">--embed-thumbnail</code> flags across video, audio, playlist, and batch modes.
            </li>
            <li class="pl-4 border-l-2 border-dracula-red/50">
              <strong class="text-ink">Dry-Run, Rate Limiting & Playlist Retries</strong> — Added <code class="bg-[#18181b] text-white px-1.5 py-0.5 rounded font-mono text-[12px]">--dry-run</code> / <code class="bg-[#18181b] text-white px-1.5 py-0.5 rounded font-mono text-[12px]">--simulate</code>, <code class="bg-[#18181b] text-white px-1.5 py-0.5 rounded font-mono text-[12px]">--limit-rate</code>, and <code class="bg-[#18181b] text-white px-1.5 py-0.5 rounded font-mono text-[12px]">dracula playlist --retry-failed</code>.
            </li>
          </ul>
        </div>

        <div>
          <h4 class="text-[12px] font-mono text-muted uppercase tracking-wider mb-3">Quick Upgrade</h4>
          <CodeTabs
            blocks={[
              { label: 'Upgrade via Pip', value: 'pip install --upgrade dracula-dl', lang: 'bash', icon: '$' },
              { label: 'Check Version', value: 'dracula --version', lang: 'bash', icon: '$' },
            ]}
            defaultValue="pip install --upgrade dracula-dl"
          />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
          <div class="bg-canvas-soft/80 p-4 rounded-xl border border-hairline/60">
            <h4 class="text-[14px] font-semibold text-ink mb-2 flex items-center gap-1.5">
              <Zap class="w-4 h-4 text-dracula-orange" />
              <span>Refactoring & Quality</span>
            </h4>
            <ul class="text-[13px] text-body space-y-1.5 list-disc list-inside">
              <li>Input URL validation before yt-dlp invocation</li>
              <li>Strict exit code discipline (<code class="font-mono text-[11px]">sys.exit(1)</code>)</li>
              <li>Debug logging in <code class="font-mono text-[11px]">~/.config/dracula/debug.log</code></li>
            </ul>
          </div>
          <div class="bg-canvas-soft/80 p-4 rounded-xl border border-hairline/60">
            <h4 class="text-[14px] font-semibold text-ink mb-2 flex items-center gap-1.5">
              <Bug class="w-4 h-4 text-dracula-red" />
              <span>Bug Fixes</span>
            </h4>
            <ul class="text-[13px] text-body space-y-1.5 list-disc list-inside">
              <li>Fixed audio bitrate override in playlist downloads</li>
              <li>Fixed view count formatting for missing metadata</li>
              <li>Handled missing terminal styling gracefully</li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- Release 1.1.0 -->
    <div class="border border-hairline/60 bg-canvas-soft/50 rounded-2xl p-8 mb-12" data-animate>
      <div class="flex items-center justify-between mb-4 border-b border-hairline/50 pb-4">
        <div class="flex items-center gap-3">
          <span class="text-[18px] font-semibold text-ink">v1.1.0</span>
          <span class="bg-canvas-soft-2 text-muted font-mono text-[11px] px-2.5 py-0.5 rounded-full">Previous Release</span>
        </div>
        <span class="font-mono text-[12px] text-muted">July 28, 2026</span>
      </div>
      <p class="text-[14px] text-body leading-[1.65]">
        Added TOML config manager (<code class="font-mono text-[12px]">config.toml</code>), JSONL download history log (<code class="font-mono text-[12px]">history.jsonl</code>), and initial Rich TUI workflow enhancements.
      </p>
    </div>

    <!-- Release 1.0.4 -->
    <div class="border border-hairline/60 bg-canvas-soft/50 rounded-2xl p-8" data-animate>
      <div class="flex items-center justify-between mb-4 border-b border-hairline/50 pb-4">
        <div class="flex items-center gap-3">
          <span class="text-[18px] font-semibold text-ink">v1.0.4</span>
          <span class="bg-canvas-soft-2 text-muted font-mono text-[11px] px-2.5 py-0.5 rounded-full">Initial Release</span>
        </div>
        <span class="font-mono text-[12px] text-muted">January 15, 2026</span>
      </div>
      <p class="text-[14px] text-body leading-[1.65]">
        Initial release of <strong>The Dracula</strong> YouTube Downloader CLI featuring video quality selector, audio extraction, playlist downloading, and Rich interactive TUI.
      </p>
    </div>
  </div>
</Base>
