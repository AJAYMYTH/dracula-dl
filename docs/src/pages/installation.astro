---
import Base from '../layouts/Base.astro';
import CodeTabs from '../components/CodeTabs.astro';
import { Download, Cpu, CheckCircle2 } from 'lucide-astro';
---

<Base title="Installation" description="Install The Dracula YouTube downloader CLI globally via PyPI or from source.">
  <div class="max-w-[800px] mx-auto px-4 sm:px-6 py-12 sm:py-20">
    <div class="mb-10 sm:mb-14" data-animate>
      <p class="font-mono text-[11px] sm:text-[12px] text-dracula-red uppercase tracking-wider mb-2 sm:mb-3 flex items-center gap-1.5">
        <Download class="w-3.5 h-3.5" />
        <span>Getting Started</span>
      </p>
      <h1 class="text-[30px] sm:text-[42px] md:text-[52px] font-semibold tracking-display-lg text-ink mb-3 sm:mb-4">Installation.</h1>
      <p class="text-[15px] sm:text-[17px] text-body leading-[1.65]">Get The Dracula installed on your machine in a few simple steps.</p>
    </div>

    <!-- Step 1: PyPI -->
    <section class="mb-12 sm:mb-16 border-b border-hairline/60 pb-10 sm:pb-12" data-animate>
      <div class="flex items-center gap-3 mb-3 sm:mb-4">
        <div class="w-7 h-7 rounded-full bg-canvas-soft-2 border border-hairline/80 flex items-center justify-center text-ink text-[12px] font-mono font-semibold shrink-0">01</div>
        <h2 class="text-[20px] sm:text-[24px] font-semibold tracking-tight text-ink">Install via PyPI (Recommended)</h2>
      </div>
      <p class="text-[13.5px] sm:text-[14px] text-body leading-[1.65] mb-4 sm:mb-5">The recommended way to install The Dracula globally across macOS, Linux, and Windows:</p>

      <CodeTabs
        blocks={[
          { label: 'Install', value: 'pip install dracula-dl', lang: 'bash', icon: '$' },
          { label: 'Upgrade', value: 'pip install --upgrade dracula-dl', lang: 'bash', icon: '$' },
        ]}
        defaultValue="pip install dracula-dl"
      />
    </section>

    <!-- Step 2: Source -->
    <section class="mb-12 sm:mb-16 border-b border-hairline/60 pb-10 sm:pb-12" data-animate>
      <div class="flex items-center gap-3 mb-3 sm:mb-4">
        <div class="w-7 h-7 rounded-full bg-canvas-soft-2 border border-hairline/80 flex items-center justify-center text-ink text-[12px] font-mono font-semibold shrink-0">02</div>
        <h2 class="text-[20px] sm:text-[24px] font-semibold tracking-tight text-ink">Install from Source</h2>
      </div>
      <p class="text-[13.5px] sm:text-[14px] text-body leading-[1.65] mb-4 sm:mb-5">For local development or building directly from repository:</p>

      <CodeTabs
        blocks={[
          {
            label: 'Git Clone',
            value: `git clone https://github.com/AJAYMYTH/dracula-dl.git
cd dracula-dl
pip install -r requirements.txt`,
            lang: 'bash',
            icon: '$',
          },
          {
            label: 'pipx',
            value: `pip install pipx
pipx install git+https://github.com/AJAYMYTH/dracula-dl.git`,
            lang: 'bash',
            icon: '$',
          },
        ]}
      />
    </section>

    <!-- Step 3: FFmpeg -->
    <section class="mb-12 sm:mb-16 border-b border-hairline/60 pb-10 sm:pb-12" data-animate>
      <div class="flex items-center gap-3 mb-3 sm:mb-4">
        <div class="w-7 h-7 rounded-full bg-canvas-soft-2 border border-hairline/80 flex items-center justify-center text-ink text-[12px] font-mono font-semibold shrink-0">03</div>
        <h2 class="text-[20px] sm:text-[24px] font-semibold tracking-tight text-ink">Install FFmpeg</h2>
      </div>
      <p class="text-[13.5px] sm:text-[14px] text-body leading-[1.65] mb-4 sm:mb-5">FFmpeg is required for audio extraction (MP3/FLAC/M4A) and video stream merging.</p>

      <CodeTabs
        blocks={[
          { label: 'Windows', value: 'winget install --id=Gyan.FFmpeg -e', lang: 'bash', icon: '$' },
          { label: 'macOS', value: 'brew install ffmpeg', lang: 'bash', icon: '$' },
          { label: 'Linux', value: 'sudo apt install ffmpeg', lang: 'bash', icon: '$' },
        ]}
      />
    </section>

    <!-- Step 4: Verification -->
    <section class="mb-12 sm:mb-16 border-b border-hairline/60 pb-10 sm:pb-12" data-animate>
      <div class="flex items-center gap-3 mb-3 sm:mb-4">
        <div class="w-7 h-7 rounded-full bg-canvas-soft-2 border border-hairline/80 flex items-center justify-center text-ink text-[12px] font-mono font-semibold shrink-0">04</div>
        <h2 class="text-[20px] sm:text-[24px] font-semibold tracking-tight text-ink">Verify System Setup</h2>
      </div>
      <p class="text-[13.5px] sm:text-[14px] text-body leading-[1.65] mb-4 sm:mb-5">Run the CLI help and FFmpeg commands to verify your setup:</p>

      <CodeTabs
        blocks={[
          {
            label: 'Verify',
            value: `# Check Dracula CLI
dracula --help

# Check FFmpeg Installation
ffmpeg -version`,
            lang: 'bash',
            icon: '$',
          },
        ]}
      />
    </section>

    <!-- Prerequisites -->
    <section data-animate>
      <h2 class="text-[20px] sm:text-[24px] font-semibold tracking-tight text-ink mb-4 flex items-center gap-2">
        <Cpu class="w-5 h-5 text-dracula-red shrink-0" />
        <span>System Requirements</span>
      </h2>
      <div class="bg-canvas-soft-2 border border-hairline/80 rounded-xl p-5 sm:p-6">
        <ul class="space-y-3.5">
          {[
            'Python 3.10 or higher',
            'yt-dlp (automatically installed via dependencies)',
            'colorama, rich, questionary (automatically installed)',
            'FFmpeg binary on PATH for audio extraction and container merging',
          ].map((req) => (
            <li class="flex items-start gap-3 text-[13.5px] sm:text-[14px] text-body">
              <CheckCircle2 class="w-4 h-4 text-dracula-green shrink-0 mt-0.5" />
              <span>{req}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </div>
</Base>
